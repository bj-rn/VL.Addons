[Category("Mixer")]
[Tags("blend fade lerp mix")]
[Summary("Lerp between two textures")]

shader Lerp_Internal_TextureFX : MixerBase
{
    float4 Mix(float4 tex0col, float4 tex1col, float fader)
    {
        float4 c0 = tex0col;
        float4 c1 = tex1col;

        return lerp(tex0col, tex1col, fader);
    }
};