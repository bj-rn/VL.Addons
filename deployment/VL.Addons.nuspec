<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>VL.Addons</id>
    <version>{{ VERSION }}</version>
    <title>VL.Addons</title>
    <authors>vvvv community</authors>
    <owners>vvvv community</owners>
    <license type="expression">MIT</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <readme>README.md</readme>
    <projectUrl>https://github.com/bj-rn/VL.Addons</projectUrl>
    <repository type="git" url="https://github.com/bj-rn/VL.Addons.git" />
    <summary>Various addons for VL</summary>
    <description>Various addons provided by the community.</description>
    <copyright>Copyright © 2026</copyright>
    <tags>VL, vvvv, gamma, addons, texturefx, shader, effect</tags>
    <dependencies>
      <dependency id="VL.Addons.2D" version="{{ VERSION }}" />
      <dependency id="VL.Addons.Animation" version="{{ VERSION }}" />
      <dependency id="VL.Addons.Collections" version="{{ VERSION }}" />
      <dependency id="VL.Addons.Color" version="{{ VERSION }}" />
      <dependency id="VL.Addons.Control" version="{{ VERSION }}" />
      <dependency id="VL.Addons.Math" version="{{ VERSION }}" />
      <dependency id="VL.Addons.Skia" version="{{ VERSION }}" />
      <dependency id="VL.Addons.Stride" version="{{ VERSION }}" />
    </dependencies>
    <icon>resources\icon.png</icon>
  </metadata>
  <files>
    <file src="..\VL.Addons\*.vl"/>
    <file src="..\resources\**\*.*" target="resources" exclude="" />
    <file src="..\README.md" />
    <file src="..\LICENSE" />
  </files>
</package>
